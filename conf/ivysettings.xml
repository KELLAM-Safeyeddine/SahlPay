<ivysettings>
  <settings defaultResolver="dependencies"/>
  <resolvers>
    <chain name="dependencies" returnFirst="true">
      <ibiblio name="central" m2compatible="true" root="https://repo.maven.apache.org/maven2/"/>
      <ibiblio name="spark-packages" m2compatible="true" root="https://repos.spark-packages.org/"/>
    </chain>
  </resolvers>
</ivysettings>
